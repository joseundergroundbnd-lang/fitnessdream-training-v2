{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized gym owner, coach, or turnstile scanner device operator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["owner", "coach", "scanner"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "role", "createdAt"]
    },
    "GymMember": {
      "title": "GymMember",
      "description": "Operational gym member profile synced across member phone, reception PC, and turnstile QR scanner (no PII email/phone).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tier": {
          "type": "string",
          "enum": ["Socio Fundador", "Socio Club"]
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "feeStatus": {
          "type": "string",
          "enum": ["al-dia", "pendiente"]
        },
        "monthlyFee": {
          "type": "number"
        },
        "streakDays": {
          "type": "number"
        },
        "totalCheckIns": {
          "type": "number"
        },
        "lastCheckInLabel": {
          "type": "string",
          "maxLength": 64
        },
        "daysSinceLastVisit": {
          "type": "number"
        },
        "outreachStatus": {
          "type": "string",
          "enum": ["pendiente", "contactado", "reactivado"]
        },
        "lastOutreachNote": {
          "type": "string",
          "maxLength": 500
        },
        "assignedCoach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "isRealMember": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "memberCode",
        "name",
        "tier",
        "goal",
        "feeStatus",
        "monthlyFee",
        "streakDays",
        "totalCheckIns",
        "lastCheckInLabel",
        "daysSinceLastVisit",
        "outreachStatus",
        "assignedCoach",
        "isRealMember",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemberPrivateContact": {
      "title": "MemberPrivateContact",
      "description": "Isolated PII contact details (email and phone) accessible only to the member owner or gym admins.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
    "AccessLog": {
      "title": "AccessLog",
      "description": "Immutable turnstile QR scan audit entry created by an authorized scanner or reception PC.",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "memberCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32
        },
        "feeStatus": {
          "type": "string",
          "enum": ["al-dia", "pendiente"]
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scannerLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "scannedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "memberId",
        "memberUid",
        "memberName",
        "memberCode",
        "feeStatus",
        "allowed",
        "reason",
        "scannerLabel",
        "scannedByUid",
        "createdAt"
      ]
    },
    "LiveCoachRoutine": {
      "title": "LiveCoachRoutine",
      "description": "Official routine sent by any authorized coach (Javi Busta, Joel, etc.) to a specific member exclusively or to all members, including muscle-group exercises (1-10 sets, fixed reps or pyramid, weight/intensity, rest) and optional cardio block.",
      "type": "object",
      "properties": {
        "targetMemberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetMemberName": {
          "type": "string",
          "maxLength": 100
        },
        "targetMemberCode": {
          "type": "string",
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "frequency": {
          "type": "string",
          "enum": ["Diaria", "Semanal", "Mensual", "Trimestral"]
        },
        "dayLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "coachId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "coachName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "coachRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "coachMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "machineCodes": {
          "type": "array"
        },
        "exercises": {
          "type": "array"
        },
        "cardioBlock": {
          "type": "object"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "targetMemberId",
        "title",
        "frequency",
        "dayLabel",
        "coachId",
        "coachName",
        "coachRole",
        "goal",
        "coachMessage",
        "machineCodes",
        "createdByUid",
        "createdAt"
      ]
    },
    "LiveDirectMessage": {
      "title": "LiveDirectMessage",
      "description": "Real-time text or short voice note between a member and Coach Javi Busta or Joel.",
      "type": "object",
      "properties": {
        "coachId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderRole": {
          "type": "string",
          "enum": ["socio", "coach"]
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "type": "string",
          "enum": ["text", "audio"]
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "audioDataUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "audioDurationSec": {
          "type": "number"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "coachId",
        "memberId",
        "senderRole",
        "senderName",
        "kind",
        "authorUid",
        "createdAt"
      ]
    },
    "AuthorizedStaffEmail": {
      "title": "AuthorizedStaffEmail",
      "description": "Authorized gym owner, official club Google account (e.g. fitnessdream), coach, or scanner email address allowed full gym management access.",
      "type": "object",
      "properties": {
        "staffId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["gym-main", "owner", "coach", "scanner"]
        },
        "addedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["staffId", "email", "label", "role", "addedByUid", "createdAt", "updatedAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Web Push (RFC 8291 VAPID) device subscription for a gym member (iOS Home Screen PWA, Android Chrome, or Desktop). Contains zero PII.",
      "type": "object",
      "properties": {
        "subId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^https://.*$"
        },
        "p256dh": {
          "type": "string",
          "minLength": 20,
          "maxLength": 256
        },
        "auth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "enum": ["ios", "android", "desktop", "other"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["subId", "uid", "endpoint", "p256dh", "auth", "platform", "createdAt", "updatedAt"]
    },
    "StaffPushSubscription": {
      "title": "StaffPushSubscription",
      "description": "Web Push (RFC 8291 VAPID) device subscription for authorized gym staff (Reception PC, Coach Javi, Coach Joel). Contains zero PII.",
      "type": "object",
      "properties": {
        "subId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["staff"]
        },
        "endpoint": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^https://.*$"
        },
        "p256dh": {
          "type": "string",
          "minLength": 20,
          "maxLength": 256
        },
        "auth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "enum": ["ios", "android", "desktop", "other"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["subId", "uid", "role", "endpoint", "p256dh", "auth", "platform", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized coaches, receptionists, and scanner operators keyed by UID."
    },
    "/authorizedStaff/{staffId}": {
      "schema": { "$ref": "#/entities/AuthorizedStaffEmail" },
      "description": "Authorized gym and coach Google email addresses keyed by normalized email doc ID so the owner can switch to the official gym email or add coaches from the app."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/GymMember" },
      "description": "Operational member records (fee status, memberCode, check-in stats) without PII."
    },
    "/members/{memberId}/private/{docId}": {
      "schema": { "$ref": "#/entities/MemberPrivateContact" },
      "description": "PII-isolated private contact info (email, phone) readable only by the member owner or admin."
    },
    "/members/{memberId}/pushSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/PushSubscription" },
      "description": "Member Web Push subscriptions for background/closed-app iOS & Android alerts."
    },
    "/staffPushSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/StaffPushSubscription" },
      "description": "Authorized gym & coach Web Push subscriptions for background new-member and incoming chat alerts."
    },
    "/accessLogs/{logId}": {
      "schema": { "$ref": "#/entities/AccessLog" },
      "description": "Immutable live turnstile QR access logs."
    },
    "/coachRoutines/{routineId}": {
      "schema": { "$ref": "#/entities/LiveCoachRoutine" },
      "description": "Live routines sent by Javi Busta or Joel to members."
    },
    "/directMessages/{messageId}": {
      "schema": { "$ref": "#/entities/LiveDirectMessage" },
      "description": "Live messages and short voice notes between members and coaches."
    }
  }
}
