{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|src/assets/|dossier/|icon-pedestal-.*\\.png|pwa-.*\\.png|apple-touch-icon\\.png|sw\\.js|registerSW\\.js|workbox-.*\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
